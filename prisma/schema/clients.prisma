model Client {
  id           String   @id @default(uuid())
  freelancerId String
  name         String
  email        String
  phone        String?
  companyName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  freelancer User        @relation("FreelancerClients", fields: [freelancerId], references: [id])
  agreements Agreement[]

  @@unique([freelancerId, email])
  @@index([freelancerId])
}
