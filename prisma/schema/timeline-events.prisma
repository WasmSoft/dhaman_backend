enum TimelineEventType {
  AGREEMENT_CREATED
  AGREEMENT_SENT
  AGREEMENT_APPROVED
  AGREEMENT_COMPLETED
  AGREEMENT_CHANGES_REQUESTED
  AGREEMENT_REJECTED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_DELETED
  MILESTONES_REORDERED
  PAYMENT_RESERVED
  PAYMENT_CLIENT_REVIEW
  PAYMENT_RELEASED
  PAYMENT_STATUS_CHANGED
  PAYMENT_ESCALATED_TO_AI
  PAYMENT_READY_TO_RELEASE
  PAYMENT_ON_HOLD
  DELIVERY_SUBMITTED
  DELIVERY_ACCEPTED
  DELIVERY_CHANGES_REQUESTED
  CHANGE_REQUEST_CREATED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_DECLINED
  CHANGE_REQUEST_FUNDED
  AI_REVIEW_REQUESTED
  AI_REVIEW_COMPLETED
  AI_REVIEW_RECOMMENDATION_ACCEPTED
  EMAIL_SENT
  AGREEMENT_ACTIVATED
  AGREEMENT_CANCELLED
}

model TimelineEvent {
  id            String            @id @default(uuid())
  agreementId   String
  milestoneId   String?
  actorRole     TimelineActorRole
  actorId       String?
  type          TimelineEventType
  title         String
  description   String
  metadata      Json?
  requestId     String?
  correlationId String?
  createdAt     DateTime          @default(now())

  agreement Agreement  @relation(fields: [agreementId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  actor     User?      @relation("TimelineActor", fields: [actorId], references: [id])

  @@index([agreementId])
  @@index([milestoneId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}
